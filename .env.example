# Server
PORT=8787
# Optional: when set, the server persists room event logs and the content bank to PostgreSQL.
# When unset, the server runs with in-memory storage (development only).
DATABASE_URL=postgresql://ft:ft@localhost:5432/football_trivia
# Used to sign session tokens (HMAC). Generate with: openssl rand -hex 32
SESSION_SECRET=replace_with_random_secret
# Admin content studio access token (server-side only). Required for /api/admin/*.
ADMIN_TOKEN=replace_with_admin_token
# Infrastructure safeguard (NOT a product rule): max concurrent spectator sockets per room.
SPECTATOR_SOFT_CAP=500
LOG_LEVEL=info
# football-data.org (real data). Token from https://www.football-data.org (server-side only, never commit).
# Fetches in the background at boot; questions stay BLOCKED until you record the license in the
# Content Studio and need your approval before they are played.
FOOTBALL_DATA_API_KEY=
FOOTBALL_DATA_COMPETITIONS=PL,PD,SA,BL1,FL1
# Season start years; default = last three completed seasons + current
FOOTBALL_DATA_SEASONS=

# Wikidata + OpenFootball (CC0) ingestion for the football-data.org clubs/leagues
OPEN_DATA_ENABLED=true
OPEN_DATA_AUTO_INGEST=true
