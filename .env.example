# Server
PORT=8787
# Optional: when set, the server persists room event logs and the content bank to PostgreSQL.
# When unset, the server runs with in-memory storage (development only).
DATABASE_URL=postgresql://ft:ft@localhost:5432/football_trivia
# Used to sign session tokens (HMAC). Generate with: openssl rand -hex 32
SESSION_SECRET=replace_with_random_secret
# Admin content studio access token (server-side only). Required for /api/admin/*.
ADMIN_TOKEN=replace_with_admin_token
# Infrastructure safeguard (NOT a product rule): max concurrent spectator sockets per room.
SPECTATOR_SOFT_CAP=500
LOG_LEVEL=info
# Add only licensed provider credentials on the server. None is integrated yet (see docs/DATA_SOURCES.md).
FOOTBALL_DATA_API_KEY=
